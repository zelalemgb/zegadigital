# ─── Meta WhatsApp Cloud API ───────────────────────────────────────────────
# From your Meta App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v21.0

# Webhook verification (you choose this string; enter the same value in the
# Meta App dashboard when configuring the webhook callback URL)
VERIFY_TOKEN=choose_a_random_verify_token

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000

# Default language served before a user picks one: en | am | om
DEFAULT_LANG=en

# ─── Manager dashboard ─────────────────────────────────────────────────────
# Password for the analytics dashboard at /admin (HTTP Basic — any username,
# this as the password). Leave unset to keep the dashboard disabled.
ADMIN_TOKEN=choose_a_strong_dashboard_password

# ─── Proactive reminders / nudges ──────────────────────────────────────────
# Run the nudge scheduler inside the web process (fine for a single instance).
RUN_SCHEDULER=true
# Sweep interval in ms (default 15 min).
SWEEP_MS=900000
# Max nudge sends in flight per sweep.
NUDGE_CONCURRENCY=8
# GO-LIVE GATE: keep 'false' until the stage templates (zega_almost_there,
# zega_quiz_left, zega_cert_ready, zega_reengagement) are APPROVED in WhatsApp
# Manager. While false the scheduler runs in DRY-RUN (logs, never sends). See
# docs/whatsapp-templates.md.
NUDGE_TEMPLATES_READY=false
# Learner languages that receive reminders. Default English-only while Amharic /
# Afaan Oromo templates are still being registered. Widen once they're approved:
# NUDGE_LANGS=en,am,om
NUDGE_LANGS=en
# Run the whole app on Ethiopian time so reminder hours + streak day-boundaries
# are local. Without this the server is UTC (19:00 UTC = 10pm EAT).
TZ=Africa/Addis_Ababa
# Earliest hour (0-23, server clock = EAT with TZ above) to send the daily
# reminder. 20 = 8pm, the evening engagement peak. A/B test to tune.
NUDGE_HOUR=20

# ─── Public landing page ───────────────────────────────────────────────────
# WhatsApp business number the landing-page QR code / "Chat" button deep-link
# to (international format; +, spaces and dashes are ignored). Unset = the page
# shows a "coming soon" placeholder instead of the QR.
PUBLIC_WA_NUMBER=+2519XXXXXXXX
# Optional pre-filled first message when a visitor taps through (default "Hi").
PUBLIC_WA_MESSAGE=Hi
